<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ddelgadoS5.Views.vPersona"
             Title="vPersona">
    <VerticalStackLayout
        Padding="15"
        Spacing="15">
        <Label 
            Text="Semana 5: BASES DE DATOS LOCALES"
            FontSize="20"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <Entry x:Name="txtNombre"
               Placeholder="Ingrese nombre"
               Keyboard="Text" />
        
        <Grid Padding="5"
              RowSpacing="5"
              ColumnSpacing="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            
            <Button x:Name="btnAgregar"
                    Text="Agregar Persona"
                    Grid.Row="0"
                    Grid.Column="0"
                    Clicked="btnAgregar_Clicked" /> 
            <Label x:Name="lblStatusMessage"
                   TextColor="Red"
                   Grid.Row="1"
                   Grid.Column="0" />
            <Button x:Name="btnMostrar"
                    Text="Mostrar Personas"
                    Grid.Row="2"
                    Grid.Column="0"
                    Clicked="btnMostrar_Clicked" />
            <CollectionView x:Name="listaPersonas"
                            Grid.Row="3"
                            Grid.Column="0">
                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Grid Padding="2"
                              RowSpacing="2"
                              ColumnSpacing="2">
                            <Grid.RowDefinitions>
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Label Text="{Binding Id}"
                                   Grid.Row="0"
                                   Grid.Column="0"/>
                            <Label Text="{Binding Name}"
                                   Grid.Row="0"
                                   Grid.Column="1"/>
                            <Button Text="Eliminar"
                                    Grid.Row="0"
                                    Grid.Column="2"
                                    CommandParameter="{Binding Id}"
                                    Clicked="btnEliminar_Clicked"/>
                        </Grid>
                        
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </VerticalStackLayout>
</ContentPage>